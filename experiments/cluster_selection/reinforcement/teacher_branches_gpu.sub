# Shared-filesystem DAG node. See teacher_branches_gpu.dag and README.md.
# These variables must be inherited by DAGMan through -include_env.
repo_root = $ENV(CLUSTER_REPO_ROOT)
python_exec = $ENV(CLUSTER_GPU_PYTHON)
run_root = $ENV(CLUSTER_RUN_ROOT)
universe = vanilla
initialdir = $(repo_root)
executable = $(python_exec)
transfer_executable = False
should_transfer_files = NO

parent_checkpoint = $(initial_checkpoint:$(run_root)/warmup/policy.best.pt)
# Explicitly omit initialization for a fresh warmup; preserve legacy parents.
if $(fresh_start:false)
    checkpoint_args =
else
    checkpoint_args = --initial-checkpoint '$(parent_checkpoint)'
endif
arguments = "-u -m experiments.cluster_selection.reinforcement.$(learner:learn) '$(run_root)/development.json' --output '$(run_root)/$(run_name)/policy.pt' $(checkpoint_args) --device cuda --width 32 --rounds 2 --lr 0.0003 --seed $(run_seed:0) --epochs $(epochs:60) --puzzles-per-epoch $(puzzles_per_epoch:90) --rollouts 4 --steps 3 --teacher-candidates $(teacher_candidates:64) --teacher-max-steps $(teacher_max_steps:8192) $(teacher_search_args:) --teacher-mutations 32 --teacher-probes 80 --max-cores 64 --max-open-colors 6 --max-work 1000000 --max-size 100000 --cluster-attempts $(cluster_attempts:32) --decoder $(decoder:depth_first) --search-nodes 10000 --validation-seconds $(validation_seconds:600) --validation-interval $(validation_interval:10) --checkpoint-every $(checkpoint_every:5) --progress-every $(progress_every:100) $(phase_args)"

request_gpus = 1
# Modern cu128/cu130 PyTorch wheels omit Pascal/P100 (capability 6.0).
# This floor is conservative for the shared alphareason CUDA 12.8 environment.
require_gpus = Capability >= 7.5
request_cpus = 1
request_memory = $(job_memory:16GB)
request_disk = 4GB
getenv = PATH, LD_LIBRARY_PATH
environment = "OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1"
output = $(run_root)/$(run_name).out
error = $(run_root)/$(run_name).err
log = $(run_root)/$(run_name).log
stream_output = True
stream_error = True
on_exit_hold = (ExitBySignal =?= True) || (ExitCode =!= 0)
queue 1
